        {
          "id": "01",
          "speaker": 52,
          "say": "緊張してる？"
        },
        {
          "id": "02",
          "speaker": 12,
          "say": "…してる。でも、地方大会ほどじゃない。"
        },
        {
          "id": "03",
          "speaker": 52,
          "say": "NPOの人たちに聞いた話、入れた？"
        },
        {
          "id": "04",
          "speaker": 12,
          "say": "うん。送り迎えできる大人が、足りないって。"
        },
        {
          "id": "05",
          "speaker": 12,
          "say": "…公園で聞いた、見守る大人が減ったと、同じだった。"
        },
        {
          "id": "06",
          "speaker": 52,
          "say": "…つながったな。"
        },
        {
          "id": "07",
          "speaker": 3,
          "say": "カナタ。最初に書いた自己PR、覚えてるのだ？"
        },
        {
          "id": "08",
          "speaker": 12,
          "say": "…人前で、自分の考えを、伝えられるようになりたい。"
        },
        {
          "id": "09",
          "speaker": 3,
          "say": "今日が、その日なのだ。"
        },
        {
          "id": "10",
          "speaker": 8,
          "say": "カナタ、次だよ。"
        },
        {
          "id": "11",
          "speaker": 12,
          "say": "宇野カナタです。森下議員の事務所で、2か月、インターンをしました。"
        },
        {
          "id": "12",
          "speaker": 12,
          "say": "…最初は、面接で答えるために、参加しました。"
        },
        {
          "id": "13",
          "speaker": 12,
          "say": "議会は、分からない言葉ばかりでした。でも、聞いたら、教えてもらえました。"
        },
        {
          "id": "14",
          "speaker": 12,
          "say": "地方大会では、負けました。地域の人には聞きましたか、と聞かれて、何も言えませんでした。"
        },
        {
          "id": "15",
          "speaker": 12,
          "say": "…だから、聞きに行きました。"
        },
        {
          "id": "16",
          "speaker": 12,
          "say": "道が危ない。行く場所がない。見守る大人が、減った。…地図の上では、分からないことでした。"
        },
        {
          "id": "17",
          "speaker": 3,
          "say": "…伝えられたのだ。"
        },
        {
          "id": "18",
          "speaker": 12,
          "say": "森下さんへ。分からないことを、聞いていいと教えてくれて、ありがとうございました。"
        },
        {
          "id": "19",
          "speaker": 12,
          "say": "…一緒に、聞きに行ってくれて、ありがとうございました。"
        },
        {
          "id": "20",
          "speaker": 8,
          "say": "カナタ、変わったね。"
        },
        {
          "id": "21",
          "speaker": 12,
          "say": "…そうですか？"
        },
        {
          "id": "22",
          "speaker": 8,
          "say": "説明会のときは、ほとんどしゃべらなかったのに。"
        },
        {
          "id": "23",
          "speaker": 12,
          "say": "…あのときは、選び方だけだった。"
        },
        {
          "id": "24",
          "speaker": 12,
          "say": "でも本当は、最初から…"
        },
        {
          "id": "25",
          "speaker": 12,
          "say": "…答えのためじゃ、なかったんだ。"
        },
        {
          "id": "26",
          "speaker": 3,
          "say": "じゃあ、何のためだったのだ？"
        },
        {
          "id": "27",
          "speaker": 12,
          "say": "……知りたかったんだ。この街の人が、何を思ってるか。"
        },
        {
          "id": "28",
          "speaker": 12,
          "say": "前は、これで答えられるって、思ってた。"
        },
        {
          "id": "29",
          "speaker": 3,
          "say": "…今は？"
        },
        {
          "id": "30",
          "speaker": 12,
          "say": "…分かんない。でも、話したいことが、ある。"
        },
        {
          "id": "31",
          "speaker": 3,
          "say": "怖くないのだ？"
        },
        {
          "id": "32",
          "speaker": 12,
          "say": "…怖いよ。"
        },
        {
          "id": "33",
          "speaker": 3,
          "say": "行くのだ。"
        },
        {
